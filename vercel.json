{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/frontend/static/$1" },
    { "source": "/auth/callback", "destination": "/frontend/callback.html" },
    { "source": "/webapp", "destination": "/frontend/index.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/index.html" }
  ]
}
